# Cliente Oracle usado por el lanzador: sqlcl (por defecto) o sqlplus
SQL_CLIENT=sqlcl

# Ruta completa al ejecutable.
# SQLcl: C:/oracle/sqlcl/bin/sql.exe   |   SQL*Plus: C:/oracle/instantclient_19_20/sqlplus.exe
# En Windows se recomiendan barras normales (/).
SQLPLUS_BIN=C:/oracle/sqlcl/bin/sql.exe

# Usuario SOLO del lado servidor (nunca se envía al navegador).
# La contraseña NO se guarda aquí: se descifra de .config y queda en memoria del servidor.
DB_USER=system

# Conexión habitual: //host:1521/SERVICE o un alias de tnsnames.ora
DB_CONNECT=//localhost:1521/ORCL

# Modo de conexión directa (se activa desde el engranaje de la interfaz)
# Cuando es true se usa DB_HOST + DB_PORT + DB_SERVICE para construir DB_CONNECT.
DIRECT_CONNECTION=false
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=ORCL

# Vacío = usar la ubicación por defecto de Oracle.
# Si usas un alias TNS, indica la carpeta real (por ejemplo <SQLCL_HOME>/network/admin).
TNS_ADMIN=

# Recomendado para consistencia de salida (SQLcl usa JDBC, pero se mantiene por compatibilidad).
NLS_LANG=AMERICAN_AMERICA.AL32UTF8

# Timeout por job en milisegundos (por defecto 120000)
JOB_TIMEOUT_MS=120000

# Opciones JVM para SQLcl, inyectadas como JAVA_TOOL_OPTIONS.
# Solo si tu JVM las soporta. Ejemplo para Java recientes:
# JAVA_OPTS=--enable-native-access=ALL-UNNAMED --enable-final-field-mutation=ALL-UNNAMED
JAVA_OPTS=

# Clave AES-256 de 32 bytes para descifrar la contraseña única de .config.
# Base64 (32 bytes) o hexadecimal (64 caracteres). Nunca se envía al navegador.
CONFIG_ENCRYPTION_KEY=

# Consola SSH: el selector lee las IP de instancias_ips.json.
# Solo el usuario se configura aquí; la IP se elige en la interfaz y se valida en servidor.
SSH_USER=oracle

# Opcionales. SSH_OPTS se pasa como argumentos (sin shell), por ejemplo:
# SSH_OPTS=-o StrictHostKeyChecking=accept-new -o ConnectTimeout=10
SSH_PORT=22
SSH_BIN=ssh
SSH_OPTS=
