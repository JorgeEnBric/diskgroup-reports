---
import '@xterm/xterm/css/xterm.css';
import '../styles/global.css';
import QueryRunner from '../components/QueryRunner';
import SettingsPanel from '../components/SettingsPanel';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Diskgroup Center: validación de diskgroups ASM mediante consultas SQLcl o SQL*Plus." />
    <link rel="icon" href="/oracle.svg" type="image/svg+xml" />
    <title>Diskgroup Center</title>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <div class="brand">
          <span class="brand-mark" aria-hidden="true">
            <img src="/oracle.svg" alt="" />
          </span>
          <div>
            <h1>Diskgroup Center</h1>
            <p>Validaciones cruzadas ágiles y reducción de errores manuales</p>
          </div>
        </div>
      </header>

      <QueryRunner client:load />

      <footer class="footer">
        <span>Diskgroup Center v1 — Base de datos </span>
      </footer>
    </div>
  </body>
</html>
